# Original game binary and the decompiler's export (not needed to run: the converted assets in game/assets/sdt are
# included; regenerate them with tools/swfconv, see README)
/original/
/extracted/

# Godot
.godot/
*.import
# temporary files of an interrupted import
*.import-*

# Tool environments
/tools/.venv/
__pycache__/
*.pyc

# Local Claude settings
/.claude/settings.local.json

# Native extension build outputs (build with scons in native/, see native/README.md)
/native/src/*.o
/native/.sconsign*.dblite
/game/bin/*.dll
!/game/bin/sdt_native.windows.template_debug.x86_64.dll
!/game/bin/sdt_native.windows.template_release.x86_64.dll
/game/bin/*.a
/game/bin/*.so
!/game/bin/sdt_native.linux.template_debug.x86_64.so
!/game/bin/sdt_native.linux.template_release.x86_64.so

# Mods folder used when running from the repo (Flash.mods_dir)
/Mods/*
# plugins made for the port ship with it (Mods/Plugins); the player's other mods stay local
!/Mods/Plugins/
# the positions the game comes with (animtools' community set) ship too; the player's own positions stay local
!/Mods/Positions/
/Mods/Positions/*
!/Mods/Positions/animtools/

# Local, machine-specific files and private working notes
/notes/
/user/
/run_debug.local.bat
/run_debug.local.sh
/native/build/
# release builds (tools/make_release.sh), and the build info it writes for the export
/release/
/game/build_info.json
